NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# The Docker Postgres from docker-compose.yml, published on host port 5436.
DATABASE_URL=postgres://s1gateway:s1gateway@localhost:5436/s1_gateway
# The SPA's origin, allowed by CORS.
CORS_ORIGIN=http://localhost:5173
# Comma-separated @sourceone.global addresses: the first System Admins. While no account
# is a System Admin, the API makes each approved account listed here one when it starts.
# Every entry must be an exact @sourceone.global mailbox or the API refuses to boot.
ACCOUNT_ADMIN_EMAILS=admin@sourceone.global
# Optional. The shared Google Sheet the Atlas Review sheet button opens:
# https://docs.google.com/spreadsheets/d/<its id>/edit. Left out, the button is not shown.
# ATLAS_REVIEW_SHEET_URL=
# Read only by `npm run db:create-admin`, for that one run: set it on the command
# line, not here. At least 12 characters.
# ADMIN_PASSWORD=
